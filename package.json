{
  "name": "bmw-antd-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . && npm run lint:data",
    "lint:data": "node scripts/enforce-listings.js",
    "format:data": "node scripts/enforce-listings.js --fix",
    "preview": "vite preview",
    "import:car": "node scripts/parse-car-json.js && npm run format:data",
    "import:apify": "node scripts/import-full.js",
    "move:sell": "node scripts/mark-sold.js",
    "move:cakal": "node scripts/mark-cakal.js",
    "move:kazali": "node scripts/mark-kazali.js",
    "move:withoutsunroof": "node scripts/mark-withoutsunroof.js",
    "move:country": "node scripts/move-excluded-countries.js && npm run format:data",
    "refresh": "node scripts/refresh-stale.js",
    "rematch:equipment": "node scripts/rematch-equipment.js && npm run format:data",
    "rematch:drivetrain": "node scripts/rematch-drivetrain.js && npm run format:data",
    "deploy": "vercel --prod",
    "test": "node --test scripts/lib/*.test.js"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.3.3",
    "apify": "^3.7.0",
    "dotenv": "^17.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
